# Control plane — runs on the control-plane host.
#
# Copy to .env and fill in. `make secrets` generates the random values for you.
# .env is git-ignored; .env.example is not.

# --- Hosts -------------------------------------------------------------------
# CONTROL_HOST is the name on the certificate and in every issuer URL Keycloak mints.
# BIND_ADDR is the control-plane host's Tailscale address: Traefik binds there and nowhere else, so the
# control plane is reachable from the tailnet but not from the LAN or the internet.
CONTROL_HOST=identity.example.org
CONTROL_IP=100.64.0.1
# The account on the control-plane host. Not the same as the local username, so the deploy
# script must be told rather than assuming $USER.
CONTROL_SSH_USER=youruser
BIND_ADDR=100.64.0.1

# The data plane, used by the portal for the copy-paste examples it shows users.
DATA_HOST=data.example.org

# --- Member services ---------------------------------------------------------
# Every service whose gateway accepts this federation's tokens. Each gets a client
# scope, service:<audience>, and a token carries one service's audience at a time, so
# a token sent to one service is refused by every other. A service not listed here
# never receives a token minted for it. Run `make bootstrap` after changing this.
FEDERATION_SERVICES='[{"audience": "birds", "name": "Avian Visitors"}]'
# Which of them is the data plane in this repository: its web client and session
# route get that scope by default.
BIRDS_AUDIENCE=birds
# A member whose gateway signs people in with a browser adds a web block to its entry:
#   {"audience": "obs", "name": "Observations",
#    "web": {"redirect_uri": "https://web.obs.example.org/session/callback",
#            "post_logout_redirect_uri": "https://web.obs.example.org/"}}
# and gets a confidential client, member-<audience>, whose secret is set here, keyed by
# audience. Give the member its client id and secret privately. At least 32 characters:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
MEMBER_CLIENT_SECRETS='{}'

# --- Keycloak ----------------------------------------------------------------
KC_REALM=federation
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
POSTGRES_PASSWORD=

# --- GitHub OAuth App --------------------------------------------------------
# Create at https://github.com/settings/developers → New OAuth App
#   Homepage URL              https://identity.example.org/
#   Authorization callback URL
#     https://identity.example.org/realms/federation/broker/github/endpoint
#
# GitHub's servers never call that URL — only your browser does — so a tailnet-only
# host works. Run `make bootstrap` after changing these.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Confidential client secrets ---------------------------------------------
# birds-gateway is used by APISIX on the data-plane host for the session-cookie browser route; the
# same value must appear in the data plane's .env as GATEWAY_CLIENT_SECRET.
GATEWAY_CLIENT_SECRET=

# portal-admin is the portal backend's service account. It mints, rotates and revokes
# per-user credentials and deletes registrations. Never leaves this host.
PORTAL_ADMIN_SECRET=

# --- Terms and conditions ----------------------------------------------------
# Shown after every sign-in through an identity provider (keycloak/terms-flow.sh).
# TERMS_MODE: every-sign-in (the testbed's choice: people see the terms regularly)
# or once-per-version (what a real service would do). Change TERMS_VERSION to ask
# everyone again. Run `make bootstrap` after changing any of these.
TERMS_VERSION=2026-11-02
TERMS_TEXT='Try not to break the testbed.'
TERMS_MODE=every-sign-in
# How long the optional "remember my agreement" cookie lasts; 0 offers none.
TERMS_COOKIE_DAYS=365
# Signs that cookie. make secrets fills it in.
TERMS_COOKIE_SECRET=

# --- Credential policy -------------------------------------------------------
# Minted client secrets carry an expiry, with re-attestation by the owner before
# renewal — the "client secret lifecycle" item the addendum calls the most urgent.
CREDENTIAL_TTL_DAYS=90

# --- Site-local: sharing a host that already runs a reverse proxy ------------
# Leave these unset for a standalone deployment — the stack then runs its own
# Traefik on BIND_ADDR:443 and needs nothing else on the host.
#
# Set COMPOSE_FILE to publish through an existing Traefik instead. Docker Compose
# reads it from this file natively. The portal moves off "/" to PORTAL_PATH so it
# does not collide with whatever already answers there; Keycloak keeps its own
# paths, because they are baked into the issuer URL inside every token.
#
# COMPOSE_FILE=docker-compose.yml:docker-compose.shared-traefik.yml
# TRAEFIK_NETWORK=traefik
# TRAEFIK_ENTRYPOINT=websecure
# PORTAL_PATH=/portal

# Data plane — runs on the data-plane host, in front of the service being protected.
#
# Copy to .env and fill in. `make secrets` generates the random values for you.

# --- Hosts -------------------------------------------------------------------
# The name on the certificate and in every URL users see. BIND_ADDR is the data-plane host's
# Tailscale address: APISIX binds there and nowhere else.
DATA_HOST=data.example.org
DATA_IP=100.64.0.2
BIND_ADDR=100.64.0.2

# The control plane. Used only to fetch discovery and JWKS documents — never in the
# data path, and never contacted per request.
CONTROL_HOST=identity.example.org
# The control plane's base URL. Split out from the hostname so the gateway can be
# pointed at a differently-fronted Keycloak without editing the operator YAML.
CONTROL_BASE_URL=https://identity.example.org
KC_REALM=federation

# Where the Federation Portal answers. Its own root when the control plane runs
# standalone; a path prefix when it is published through a proxy it shares.
CONTROL_PORTAL_URL=https://identity.example.org/portal/

OPERATOR_CONTACT=operator@example.org

# --- The service being protected ---------------------------------------------
# Absolute paths, so the compose file does not care where it is run from.
BIRDS_SERVICE_DIR=/path/to/avian-visitors-simple-web-service
BIRDS_ASSETS_DIR=/path/to/avian-assets/illustrations

# --- Federation credential ---------------------------------------------------
# Must match GATEWAY_CLIENT_SECRET in the control plane's .env — it is the secret of
# the `birds-gateway` confidential client in Keycloak, used only by the session-cookie
# browser routes. The bearer-token routes need no secret at all: they validate against
# the published JWKS.
GATEWAY_CLIENT_SECRET=

# Encrypts the gateway's own session cookies. Local to this host; nothing else needs it.
SESSION_SECRET=

# --- The operator's own API keys ---------------------------------------------
# Nothing to do with the federation. These exist to show that federating does not mean
# giving up the ability to issue your own credentials.
LOCAL_API_KEY_ACME=
LOCAL_API_KEY_DASHBOARD=

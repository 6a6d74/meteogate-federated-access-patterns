# The federation you are joining. Its operator sends you the real values; copy this
# file to federation.env and fill them in. Everything here is public.

# The control plane: where tokens are issued and its signing keys are published.
CONTROL_BASE_URL=https://identity.example.org
KC_REALM=federation
# Where users register and get a credential. Linked from the gateway's refusal pages.
CONTROL_PORTAL_URL=https://identity.example.org/
# What the refusal pages tell someone to run to get a token.
FEDERATION_CLI_CLIENT=federation-cli
FEDERATION_ACCOUNT_NAME=meteogate
FEDERATION_HELP_URL=https://github.com/6a6d74/meteogate-federated-access-patterns/blob/main/docs/cli-clients.md
